diff --git a/tests/gateway/test_discord_auto_thread_media_ids.py b/tests/gateway/test_discord_auto_thread_media_ids.py
new file mode 100644
index 0000000000..de691b04bc
--- /dev/null
+++ b/tests/gateway/test_discord_auto_thread_media_ids.py
@@ -0,0 +1,109 @@
+"""Behavioral coverage for opt-in Instagram shortcode auto-thread names."""
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+
+from gateway.platforms.base import PlatformConfig
+from plugins.platforms.discord.adapter import DiscordAdapter
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("path", ["/p/AbC_123/", "/reel/AbC_123?igsh=tracking#frag", "/tv/AbC_123"])
+async def test_opt_in_names_thread_from_single_instagram_shortcode(path):
+    adapter = DiscordAdapter(PlatformConfig(enabled=True, extra={"auto_thread_media_ids": True}))
+    created = SimpleNamespace(name=None)
+    message = SimpleNamespace(content=f"Please look https://www.instagram.com{path}", author=SimpleNamespace(display_name="Alice"))
+    message.create_thread = AsyncMock(side_effect=lambda *, name, **kw: (setattr(created, "name", name) or created))
+    thread = await adapter._auto_create_thread(message)
+    assert thread is created
+    assert created.name == "instagram_AbC_123"
+
+
+@pytest.mark.parametrize("url", [
+    "https://instagram.com.evil/p/code", "https://instagram.com@evil.test/p/code",
+    "https://instagram.com/p/../code", "https://instagram.com/p/code/extra",
+    "https://instagram.com/p/a.b", "https://instagram.com/p/" + "a" * 80,
+    "https://example.test/?url=https://instagram.com/p/code",
+])
+def test_instagram_shortcode_parser_rejects_noncanonical_urls(url):
+    from plugins.platforms.discord.adapter_thread_titles import instagram_media_shortcode
+    assert instagram_media_shortcode(url) is None
+
+
+def test_instagram_shortcode_parser_collapses_duplicate_urls_and_rejects_distinct_ids():
+    from plugins.platforms.discord.adapter_thread_titles import instagram_media_shortcode
+    assert instagram_media_shortcode("https://instagram.com/p/AbC https://www.instagram.com/p/AbC?x=1") == "AbC"
+    assert instagram_media_shortcode("https://instagram.com/p/AbC https://instagram.com/p/Other") is None
+
+
+@pytest.mark.asyncio
+async def test_opt_in_falls_back_to_original_name_when_multiple_instagram_ids():
+    adapter = DiscordAdapter(PlatformConfig(enabled=True, extra={"auto_thread_media_ids": True}))
+    message = SimpleNamespace(content="https://instagram.com/p/one https://instagram.com/p/two", author=SimpleNamespace(display_name="Alice"))
+    message.create_thread = AsyncMock(side_effect=lambda *, name, **kw: SimpleNamespace(name=name))
+    thread = await adapter._auto_create_thread(message)
+    assert thread.name == message.content
+
+
+@pytest.mark.asyncio
+async def test_default_off_and_semantic_guard_do_not_overwrite_canonical_title():
+    adapter = DiscordAdapter(PlatformConfig(enabled=True))
+    message = SimpleNamespace(content="https://instagram.com/p/AbC_123", author=SimpleNamespace(display_name="Alice"))
+    message.create_thread = AsyncMock(side_effect=lambda *, name, **kw: SimpleNamespace(name=name))
+    assert (await adapter._auto_create_thread(message)).name.startswith("https://")
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("enabled", [True, False])
+async def test_semantic_title_guard_is_scoped_to_opt_in(monkeypatch, enabled):
+    import plugins.platforms.discord.adapter as module
+    monkeypatch.setattr(module, "DISCORD_AVAILABLE", True)
+    thread = SimpleNamespace(name="instagram_AbC_123", edit=AsyncMock())
+    adapter = DiscordAdapter(PlatformConfig(enabled=True, extra={"auto_thread_media_ids": enabled}))
+    adapter._client = SimpleNamespace(get_channel=lambda _id: thread)
+    changed = await adapter.rename_thread("800", "Descriptive title", only_if_current_name=thread.name)
+    assert changed is (not enabled)
+    assert thread.edit.await_count == int(not enabled)
+
+
+@pytest.mark.asyncio
+async def test_explicit_rename_remains_available_for_opt_in(monkeypatch):
+    import plugins.platforms.discord.adapter as module
+    monkeypatch.setattr(module, "DISCORD_AVAILABLE", True)
+    thread = SimpleNamespace(name="instagram_AbC_123", edit=AsyncMock())
+    adapter = DiscordAdapter(PlatformConfig(enabled=True, extra={"auto_thread_media_ids": True}))
+    adapter._client = SimpleNamespace(get_channel=lambda _id: thread)
+    assert await adapter.rename_thread("800", "My chosen name")
+    thread.edit.assert_awaited_once()
+
+
+@pytest.mark.asyncio
+async def test_seed_fallback_uses_canonical_name():
+    adapter = DiscordAdapter(PlatformConfig(enabled=True, extra={"auto_thread_media_ids": True}))
+    created = SimpleNamespace(name="instagram_AbC_123")
+    seed = SimpleNamespace(create_thread=AsyncMock(return_value=created))
+    message = SimpleNamespace(
+        content="https://instagram.com/reel/AbC_123/?tracking=yes",
+        author=SimpleNamespace(display_name="Alice"),
+        create_thread=AsyncMock(side_effect=RuntimeError("primary refused")),
+        channel=SimpleNamespace(send=AsyncMock(return_value=seed)),
+    )
+    assert await adapter._auto_create_thread(message) is created
+    assert seed.create_thread.await_args.kwargs["name"] == "instagram_AbC_123"
+
+
+@pytest.mark.asyncio
+async def test_string_false_does_not_enable_media_names():
+    adapter = DiscordAdapter(PlatformConfig(enabled=True, extra={"auto_thread_media_ids": "false"}))
+    message = SimpleNamespace(content="https://instagram.com/reel/AbC_123/", author=SimpleNamespace(display_name="Alice"))
+    message.create_thread = AsyncMock(side_effect=lambda *, name, **kw: SimpleNamespace(name=name))
+    assert (await adapter._auto_create_thread(message)).name == message.content
+
+
+@pytest.mark.asyncio
+async def test_non_instagram_name_preserves_existing_behavior():
+    adapter = DiscordAdapter(PlatformConfig(enabled=True, extra={"auto_thread_media_ids": True}))
+    message = SimpleNamespace(content="A normal question", author=SimpleNamespace(display_name="Alice"))
+    message.create_thread = AsyncMock(side_effect=lambda *, name, **kw: SimpleNamespace(name=name))
+    assert (await adapter._auto_create_thread(message)).name == message.content
diff --git a/website/docs/user-guide/configuration.md b/website/docs/user-guide/configuration.md
index 808b59c202..4803f9784a 100644
--- a/website/docs/user-guide/configuration.md
+++ b/website/docs/user-guide/configuration.md
@@ -2956,12 +2956,15 @@ discord:
   free_response_channels: ""     # Comma-separated channel IDs where bot responds without @mention
   auto_thread: true              # Auto-create threads on @mention in channels
   free_response_auto_thread: false  # Free-response channels also auto-thread (default: reply inline)
+  extra:
+    auto_thread_media_ids: false  # Name a thread instagram_<shortcode> for a single Instagram media URL
 ```
 
 - `require_mention` — when `true` (default), the bot only responds in server channels when mentioned with `@BotName`. DMs always work without mention.
 - `free_response_channels` — comma-separated list of channel IDs where the bot responds to every message without requiring a mention.
 - `auto_thread` — when `true` (default), mentions in channels automatically create a thread for the conversation, keeping channels clean (similar to Slack threading).
 - `free_response_auto_thread` — when `true`, channels in `free_response_channels` also auto-create a thread per top-level message. Default `false`: free-response channels reply inline. Requires `auto_thread: true`.
+- `extra.auto_thread_media_ids` — opt in to naming an auto-created thread `instagram_<shortcode>` when the submission contains exactly one distinct valid Instagram post/reel/TV URL. URL query and fragment are ignored; the shortcode's case is preserved. Invalid URLs, batches with multiple IDs, and all other messages keep the normal initial title. URLs are parsed locally and never fetched. This option is off by default; the supported native path is `platforms.discord.extra.auto_thread_media_ids: true`.
 
 ## Security
 
