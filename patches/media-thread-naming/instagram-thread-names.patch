     discord = None
 
 _MAX_RECORDS = 2000
+_INSTAGRAM_URL = re.compile(r"https?://[^\s<>\"']+", re.IGNORECASE)
+_INSTAGRAM_SHORTCODE = re.compile(r"[A-Za-z0-9_-]{1,30}\Z")
+
+
+def instagram_media_shortcode(text: str) -> str | None:
+    """Return one unambiguous public Instagram media shortcode; never dereference input."""
+    found: set[str] = set()
+    for raw in _INSTAGRAM_URL.findall(text or ""):
+        candidate = raw.rstrip(".,!?;:)")
+        try:
+            parsed = urlsplit(candidate)
+            if parsed.scheme.lower() not in {"http", "https"} or parsed.hostname not in {"instagram.com", "www.instagram.com"}:
+                continue
+            if parsed.username is not None or parsed.password is not None or parsed.port is not None:
+                continue
+        except ValueError:
+            continue
+        match = re.fullmatch(r"/(?:p|reel|tv)/([A-Za-z0-9_-]{1,30})/?", parsed.path)
+        if match and _INSTAGRAM_SHORTCODE.fullmatch(match.group(1)):
+            found.add(match.group(1))
+    return next(iter(found)) if len(found) == 1 else None
 
 
